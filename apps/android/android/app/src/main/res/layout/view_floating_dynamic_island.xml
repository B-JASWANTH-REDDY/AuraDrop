<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="0dp"
    android:paddingEnd="0dp"
    android:paddingTop="0dp"
    android:paddingBottom="16dp">

    <!-- Official Apple AirDrop Dynamic Island Style Pill Card -->
    <LinearLayout
        android:id="@+id/pill_card_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="54dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_dynamic_island_card"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:elevation="24dp">

        <!-- Top Row: Icon/Avatar + Details + Thumbnail Preview -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Left: AirDrop Radiating Waves or User Avatar -->
            <FrameLayout
                android:id="@+id/avatar_container"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="14dp">

                <!-- AuraDrop Official App Logo / Badge -->
                <ImageView
                    android:id="@+id/iv_device_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_auradrop_badge"
                    android:contentDescription="AuraDrop Icon" />

                <!-- Profile Avatar Image (if sender has custom profile picture) -->
                <ImageView
                    android:id="@+id/iv_device_avatar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="Sender Profile Avatar" />
            </FrameLayout>

            <!-- Middle: "AirDrop" Title and Subtitle -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AirDrop"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tv_sender_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nearby device would like to share"
                    android:textColor="#8E8E93"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="3dp"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Direct Wi-Fi"
                    android:textColor="#636366"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Right: Large Rounded Square File Preview Thumbnail -->
            <FrameLayout
                android:id="@+id/preview_thumbnail_container"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_preview_thumbnail_rounded"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/iv_preview_thumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_preview_file"
                    android:contentDescription="File Preview Thumbnail" />
            </FrameLayout>
        </LinearLayout>

        <!-- Middle: Real-Time Transfer Progress Bar (shown when file is in flight) -->
        <LinearLayout
            android:id="@+id/transfer_progress_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="14dp">

            <ProgressBar
                android:id="@+id/pb_transfer"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#007AFF"
                android:progressBackgroundTint="#2C2C2E" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tv_transfer_stats"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="0 MB / 0 MB • 0%"
                    android:textColor="#8E8E93"
                    android:textSize="11.5sp"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:id="@+id/tv_transfer_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 MB/s"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="11.5sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Action Pill Buttons: Apple Style Decline (#2C2C2E) & Accept (#007AFF) -->
        <LinearLayout
            android:id="@+id/actions_button_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp">

            <!-- Decline Button -->
            <FrameLayout
                android:id="@+id/btn_decline_container"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:background="@drawable/bg_pill_decline"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_btn_decline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Decline"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />
            </FrameLayout>

            <!-- Chat Button (optional, hidden during incoming transfer) -->
            <FrameLayout
                android:id="@+id/btn_chat_container"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:background="@drawable/bg_pill_decline"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="6dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_btn_chat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Chat"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />
            </FrameLayout>

            <!-- Accept Button (Apple Blue #007AFF) -->
            <FrameLayout
                android:id="@+id/btn_accept_container"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:background="@drawable/bg_pill_accept"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_btn_accept"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Accept"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
