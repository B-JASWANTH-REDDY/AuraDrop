<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="0dp"
    android:paddingEnd="0dp"
    android:paddingTop="0dp"
    android:paddingBottom="16dp">

    <!-- Sleek Minimal Floating Proximity Card Container (Zero background ripples or fake circles) -->
    <LinearLayout
        android:id="@+id/pill_card_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="28dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_dynamic_island_card"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:elevation="18dp">

        <!-- Header Info Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Real Device Avatar / Monogram Icon -->
            <FrameLayout
                android:id="@+id/avatar_container"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_photo_preview_default">

                <!-- Vector Hardware Icon (Laptop / Phone) -->
                <ImageView
                    android:id="@+id/iv_device_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_device_laptop"
                    android:tint="#FFFFFF"
                    android:contentDescription="Device Hardware Icon" />

                <!-- Real User Custom Avatar Image (if available) -->
                <ImageView
                    android:id="@+id/iv_device_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="User Profile Avatar" />
            </FrameLayout>

            <!-- Device & Proximity Details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AuraDrop Nearby"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tv_sender_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nearby Device is ready"
                    android:textColor="#A1A1AA"
                    android:textSize="12.5sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Direct Wi-Fi • 24/7 Proximity"
                    android:textColor="#71717A"
                    android:textSize="10.5sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Real File Thumbnail (Displayed only if incoming transfer contains an image) -->
            <FrameLayout
                android:id="@+id/preview_thumbnail_container"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_photo_preview_default"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/iv_preview_thumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="File Preview" />
            </FrameLayout>
        </LinearLayout>

        <!-- Real-Time Transfer Progress (Visible during active file sharing) -->
        <LinearLayout
            android:id="@+id/transfer_progress_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="12dp">

            <ProgressBar
                android:id="@+id/pb_transfer"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#FFFFFF"
                android:progressBackgroundTint="#33FFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/tv_transfer_stats"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="0 MB / 0 MB • 0%"
                    android:textColor="#A1A1AA"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:id="@+id/tv_transfer_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ 0 MB/s"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Action Pill Buttons -->
        <LinearLayout
            android:id="@+id/actions_button_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="14dp">

            <!-- Decline / Dismiss Button -->
            <FrameLayout
                android:id="@+id/btn_decline_container"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="38dp"
                android:background="@drawable/bg_pill_decline"
                android:layout_marginEnd="5dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_btn_decline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Dismiss"
                    android:textColor="#D4D4D8"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif" />
            </FrameLayout>

            <!-- Chat Button (Shown on Proximity) -->
            <FrameLayout
                android:id="@+id/btn_chat_container"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="38dp"
                android:background="@drawable/bg_pill_decline"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="5dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_btn_chat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Chat"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif" />
            </FrameLayout>

            <!-- Accept / Share Button (Pure White Pill with Bold Black Text) -->
            <FrameLayout
                android:id="@+id/btn_accept_container"
                android:layout_width="0dp"
                android:layout_weight="1.3"
                android:layout_height="38dp"
                android:background="@drawable/bg_pill_accept_navy"
                android:layout_marginStart="3dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_btn_accept"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Share Files"
                    android:textColor="#000000"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
